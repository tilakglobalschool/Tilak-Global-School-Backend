# ─────────────────────────────────────────────────────────────────────────────
# Tilak Global School — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env — it is in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Dev (Atlas):
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/tilak_school
# Example Atlas replica-set URI (for Atlas M0/M2/M5):
# MONGO_URI=mongodb://<user>:<password>@ac-xxxx-shard-00-00.mongodb.net:27017,.../<db>?ssl=true&replicaSet=atlas-xxx&authSource=admin

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins
# Dev:
CLIENT_URL=http://localhost:3000,http://localhost:3001
# Production (set on Render/server dashboard):
# CLIENT_URL=https://www.tilakglobalschool.com,https://admin-portal.tilakglobalschool.com

# ── Cookie ────────────────────────────────────────────────────────────────────
# Dev: leave blank (host-only cookie)
COOKIE_DOMAIN=
# Production: .tilakglobalschool.com  (scopes cookie to all subdomains)

# ── Render keep-alive (production only) ───────────────────────────────────────
RENDER_URL=https://api.tilakglobalschool.com

# ── Admin Seed Credentials ────────────────────────────────────────────────────
# Used by: npm run seed
ADMIN_EMAIL=admin@tilakglobalschool.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Super Admin
