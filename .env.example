# ─────────────────────────────────────────────────────────────────────────────
# Tilak Global School — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env — it is in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas (REQUIRED — localhost is NOT allowed) ──────────────────────
# Use your Atlas connection string. Localhost/127.0.0.1 will be rejected.
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/tilak_school
# Replica-set format example:
# MONGO_URI=mongodb://<user>:<pass>@shard-00-00.mongodb.net:27017,.../<db>?ssl=true&replicaSet=atlas-xxx&authSource=admin

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000,http://localhost:3001
# Production: CLIENT_URL=https://tilakglobalschool.com,https://admin-portal.tilakglobalschool.com

# ── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_DOMAIN=
# Production: COOKIE_DOMAIN=.tilakglobalschool.com

# ── Render keep-alive ─────────────────────────────────────────────────────────
RENDER_URL=https://api.tilakglobalschool.com

# ── Admin Seed ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@tilakglobalschool.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Super Admin
